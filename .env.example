# Copy to .env and fill in. docker compose reads it automatically.

# Protect the API + dashboard. Strongly recommended on any shared/from-the-internet box.
OFFGRID_API_TOKEN=

# Licensing. Generate a key per customer tier/expiry with:
#     OFFGRID_LICENSE_SECRET=<same secret> python license.py gen pro 2027-12-31
# Deploy with the SAME secret + the key. No key = Community (3 concurrent, 500 queued).
OFFGRID_LICENSE_KEY=
OFFGRID_LICENSE_SECRET=

# BYO-backend: where generic_http posts. Leaving hosted platforms = point at your
# own server/model gateway instead of a vendor.
OFFGRID_GENERIC_URL=
OFFGRID_GENERIC_API_KEY=

# Default per-job cost estimate (USD) for budget guardrails on BYO providers.
# Per-job override: payload["cost_estimate"].
OFFGRID_COST_PER_JOB=0.30

# First-party provider keys (paid directly to the provider, not to a middleman).
OPENAI_API_KEY=